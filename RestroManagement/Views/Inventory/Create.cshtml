@using RestroManagement.Models.Domain
@model Inventory
@{
    ViewBag.Title = "Create Inventory";
}

<a asp-action="Index" class="btn btn-outline-secondary mb-3">Back to Inventory List</a>

<div class="container m-1 p-1  border-0 rounded-3 shadow-sm" style="background-color:#DCC5B2;">
    <h2>Create Inventory</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">

            <div class="row mb-3">
                <label asp-for="Name" class="control-label"></label>
                <div class="col-sm-6">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="BuyingPrice" class="control-label">Buying Price</label>
                <div class="col-sm-6">
                    <input asp-for="BuyingPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="BuyingPrice" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Quantity" class="control-label"></label>
                <div class="col-sm-6">
                    <input asp-for="Quantity" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Unit" class="control-label"></label>
                <div class="col-sm-6">
                    <input asp-for="Unit" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Unit" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="ThresholdValue" class="control-label">Threshold Value</label>
                <div class="col-sm-6">
                    <input asp-for="ThresholdValue" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="ThresholdValue" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="ExpiryDate" class="control-label">Expiry Date</label>
                <div class="col-sm-6">
                    <input asp-for="ExpiryDate" class="form-control" type="date" />
                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="reset" value="Discard" class="btn btn-outline-secondary me-3" />
                    <input type="submit" value="Add Inventory" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </form>
</div>


