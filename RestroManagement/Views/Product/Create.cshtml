@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            const inventoryData = @Html.Raw(JsonSerializer.Serialize(Model.InventorySelections.Select(s => new { id = s.InventoryItemId, name = s.InventoryItemName })));

            const searchInput = document.getElementById('inventorySearch');
            const resultsBox = document.getElementById('searchResults');
            const selectedContainer = document.getElementById('selectedInventoriesContainer');

            function isSelected(id){
                const checkbox = document.querySelector('input.inventory-select[data-inventory-id="'+id+'"]');
                return checkbox ? checkbox.checked : false;
            }

            function setSelected(id, selected){
                const checkbox = document.querySelector('input.inventory-select[data-inventory-id="'+id+'"]');
                if(checkbox){
                    checkbox.checked = !!selected;
                }
            }

            function getQtyInput(id){
                return document.querySelector('input.inventory-qty[data-inventory-id="'+id+'"]');
            }

            function ensureQuantityAtLeastOne(id){
                const qtyInput = getQtyInput(id);
                if(qtyInput){
                    const val = parseInt(qtyInput.value || '0', 10);
                    if(isNaN(val) || val <= 0){
                        qtyInput.value = '1';
                    }
                }
            }

            function removeSelectedCard(id){
                const card = selectedContainer.querySelector('[data-selected-id="'+id+'"]');
                if(card){
                    card.remove();
                }
            }

            function reorderTableRows(){
                const tbody = document.querySelector('table.table tbody');
                if(!tbody) return;
                const rows = Array.from(tbody.querySelectorAll('tr')).map((row, idx) => ({
                    row: row,
                    idx: idx,
                    selected: !!row.querySelector('input.inventory-select')?.checked
                }));
                rows.sort((a, b) => {
                    if (a.selected !== b.selected) return a.selected ? -1 : 1; // selected first
                    return a.idx - b.idx; // keep original order otherwise
                });
                rows.forEach(r => tbody.appendChild(r.row));
            }

            function renderSelectedCard(item){
                // If exists, update and return
                let card = selectedContainer.querySelector('[data-selected-id="'+item.id+'"]');
                const qtyInput = getQtyInput(item.id);
                const qtyVal = qtyInput ? (qtyInput.value || '') : '';
                if(card){
                    const qtySpan = card.querySelector('[data-role="qty"]');
                    if(qtySpan) qtySpan.textContent = qtyVal;
                    return;
                }
                card = document.createElement('div');
                card.className = 'd-flex align-items-center justify-content-between border rounded p-2 mb-2';
                card.setAttribute('data-selected-id', item.id);
                card.innerHTML = '<div><strong>'+item.name+'</strong><div class="small text-muted">Qty: <span data-role="qty">'+(qtyVal || '1')+'</span></div></div>'+
                                 '<div class="d-flex gap-2">'+
                                    '<button type="button" class="btn btn-sm btn-outline-secondary" data-action="focus">Set Qty</button>'+
                                    '<button type="button" class="btn btn-sm btn-outline-danger" data-action="remove">Remove</button>'+
                                 '</div>';
                card.addEventListener('click', function(e){
                    const action = e.target && e.target.getAttribute('data-action');
                    if(action === 'remove'){
                        setSelected(item.id, false);
                        if(qtyInput){ qtyInput.value = '0'; }
                        removeSelectedCard(item.id);
                        refreshResultsButtons();
                        reorderTableRows();
                    } else if(action === 'focus'){
                        if(qtyInput){ qtyInput.focus(); qtyInput.select(); }
                    }
                });
                selectedContainer.appendChild(card);
            }

            function addInventory(id){
                const item = inventoryData.find(x => x.id === id);
                if(!item) return;
                setSelected(id, true);
                ensureQuantityAtLeastOne(id);
                renderSelectedCard(item);
                refreshResultsButtons();
                reorderTableRows();
            }

            function refreshResultsButtons(){
                if(!resultsBox) return;
                resultsBox.querySelectorAll('[data-id]').forEach(el => {
                    const id = parseInt(el.getAttribute('data-id'), 10);
                    const btn = el.querySelector('button[data-role="add"]');
                    if(btn){
                        if(isSelected(id)){
                            btn.disabled = true;
                            btn.textContent = 'Added';
                            btn.classList.remove('btn-outline-primary');
                            btn.classList.add('btn-success');
                        } else {
                            btn.disabled = false;
                            btn.textContent = 'Add';
                            btn.classList.add('btn-outline-primary');
                            btn.classList.remove('btn-success');
                        }
                    }
                });
            }

            function renderResults(items){
                if(items.length === 0){
                    resultsBox.style.display = 'none';
                    resultsBox.innerHTML = '';
                    return;
                }
                resultsBox.style.display = 'block';
                resultsBox.innerHTML = '';
                items.slice(0, 25).forEach(it => {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center p-2 border-bottom';
                    row.setAttribute('data-id', it.id);
                    row.innerHTML = '<div>'+it.name+'</div>'+
                                    '<div><button type="button" class="btn btn-sm btn-outline-primary" data-role="add">Add</button></div>';
                    row.addEventListener('click', function(e){
                        const role = e.target && e.target.getAttribute('data-role');
                        if(role === 'add'){
                            addInventory(it.id);
                        }
                    });
                    resultsBox.appendChild(row);
                });
                refreshResultsButtons();
            }

            function filter(query){
                const q = (query || '').trim().toLowerCase();
                if(q === ''){ renderResults([]); return; }
                const filtered = inventoryData.filter(it => (it.name || '').toLowerCase().includes(q));
                renderResults(filtered);
            }

            // Sync selected chips on quantity change
            document.querySelectorAll('input.inventory-qty').forEach(inp => {
                inp.addEventListener('input', function(){
                    const id = parseInt(this.getAttribute('data-inventory-id'), 10);
                    const item = inventoryData.find(x => x.id === id);
                    if(!item) return;
                    const card = selectedContainer.querySelector('[data-selected-id="'+id+'"]');
                    if(card){
                        const qtySpan = card.querySelector('[data-role="qty"]');
                        if(qtySpan) qtySpan.textContent = this.value || '';
                    }
                });
            });

            // React when user manually toggles checkbox in table
            document.querySelectorAll('input.inventory-select').forEach(cb => {
                cb.addEventListener('change', function(){
                    const id = parseInt(this.getAttribute('data-inventory-id'), 10);
                    const item = inventoryData.find(x => x.id === id);
                    if(!item) return;
                    if(this.checked){
                        ensureQuantityAtLeastOne(id);
                        renderSelectedCard(item);
                    } else {
                        removeSelectedCard(id);
                        const qtyInput = getQtyInput(id);
                        if(qtyInput){ qtyInput.value = '0'; }
                    }
                    refreshResultsButtons();
                    reorderTableRows();
                });
            });

            // Bootstrap initial state (if any pre-checked)
            inventoryData.forEach(it => {
                if(isSelected(it.id)){
                    ensureQuantityAtLeastOne(it.id);
                    renderSelectedCard(it);
                }
            });
            reorderTableRows();

            if(searchInput){
                searchInput.addEventListener('input', function(){ filter(this.value); });
            }
        })();
    </script>
}
