@using RestroManagement.Models.ViewModels
@using System.Text.Json
@model CreateProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<style>
    /* Page-scoped styles for Create Product only */
    #createProductPage .form-col {
        background-color: #ffffff;
        border: 1px solid #edf2f7;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        margin-bottom: 16px;
    }

    #createProductPage .inventory-table {
        width: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        background-color: #ffffff;
    }

    #createProductPage .inventory-table thead th {
        background: linear-gradient(180deg, #f8fafc, #eef2f7);
        font-weight: 600;
        color: #374151;
        border-bottom: 1px solid #e5e7eb;
    }

    #createProductPage .inventory-table tbody tr {
        transition: background-color .12s ease;
    }

    #createProductPage .inventory-table tbody tr:hover {
        background-color: #f9fbff;
    }

    /* Highlight selected rows */
    #createProductPage .inventory-table tbody tr:has(input.inventory-select:checked) {
        background-color: var(--brand-selected-bg);
    }

    #createProductPage .inventory-table td,
    #createProductPage .inventory-table th {
        vertical-align: middle;
    }

    #createProductPage .inventory-table .form-check-input {
        transform: scale(1.1);
        cursor: pointer;
    }

    #createProductPage .inventory-table .inventory-qty {
        max-width: 140px;
    }

    /* Spacing for headings and sections */
    #createProductPage h3 { font-weight: 700; }
    #createProductPage h4 { font-weight: 600; margin-top: 8px; }
    #createProductPage h5 { font-weight: 600; }
</style>
<a asp-action="Index" class="btn btn-secondary mb-3">Back to Product List</a>

<div id="createProductPage" class="container rounded-3 border-0 shadow-sm">
    <h3>Create New Product</h3>
    <form asp-action="Create" method="post">
        <div class="row">
            <div class="col border-0 shadow-sm rounded-3 form-col mr-2">
                
                <div class="form-group">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CategoryId">Category</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="Model.Categories">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <h5>Selected Inventories</h5>
                <div id="selectedInventoriesContainer" class="p-3 border rounded bg-white min-vh-25">
                   
                </div>
            </div>
            
            <div class="col border-0 shadow-sm rounded-3 form-col">
                <div class="mb-3">
                    <label for="inventorySearch" class="form-label">Search and Add Inventories</label>
                    <div class="input-group">
                        <input type="text" id="inventorySearch" class="form-control" placeholder="Type name to search...">
                    </div>
                    <div id="searchResults" class="mt-2 border rounded" style="max-height: 200px; overflow-y: auto; display:none;">
                        <!-- Client-side search results will be built here by JavaScript -->
                    </div>
                </div>

                <h4>Assign Inventory Items</h4>
                <table class="table table-hover align-middle inventory-table">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Inventory Item</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.InventorySelections.Count; i++)
                        {
                            <tr data-inventory-id="@Model.InventorySelections[i].InventoryItemId">
                                <td>
                                    <input type="checkbox" class="form-check-input inventory-select" data-inventory-id="@Model.InventorySelections[i].InventoryItemId" asp-for="InventorySelections[@i].Selected" />
                                    <input type="hidden" asp-for="InventorySelections[@i].InventoryItemId" />
                                    <input type="hidden" asp-for="InventorySelections[@i].InventoryItemName" />
                                </td>
                                <td>@Model.InventorySelections[i].InventoryItemName</td>
                                <td>
                                    <input asp-for="InventorySelections[@i].Quantity" class="form-control inventory-qty" data-inventory-id="@Model.InventorySelections[i].InventoryItemId" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
            
        </div>
        <button type="submit" class="btn btn-primary m-1 p-1">Create</button>
        <button type="reset" class="btn btn-outline-secondary m-1 p-1">Cancel</button>
    </form>
</div>



