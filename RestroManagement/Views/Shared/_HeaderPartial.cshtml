@{
    var currentDate = DateTime.Now;
}
<div class="container-fluid m-2 p-2 shadow-lg text-white" 
    style="border-radius:10px;background-color:#D96F32;">
    
    <div class="d-flex justify-content-between" style="align-items: center; gap: 8px;">
        <h4><b>RestroManagement</b></h4>
        <div>
            <strong>Date:</strong> <span id="current-date"></span> &nbsp; | &nbsp;
            <strong>Time:</strong> <span id="current-time"></span>
        </div>
    </div>
    
</div>

<script>
    function updateDateTime() {
        const now = new Date();
        document.getElementById('current-date').textContent = now.toLocaleDateString(undefined, {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
        document.getElementById('current-time').textContent = now.toLocaleTimeString();
    }

    updateDateTime(); // initial call
    setInterval(updateDateTime, 1000); // update every second
</script>