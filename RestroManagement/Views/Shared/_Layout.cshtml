                    </li>

                    <li class="nav-item m-1 p-0 border-0 shadow-lg">
                        <a class="nav-link text-dark border rounded p-3 fw-semibold shadow-sm 
                        @(ViewBag.ActivePage == "Manage" ? "activePage" : "")" asp-area="" asp-controller="Manage" asp-action="Index">
                            <i class="bi bi-gear h2"></i>
                            <p>Manage</p>
                        </a>
                    </li>
                    
                </ul>

            </nav>
        </div>
    
    


    <div class="container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    </div>

