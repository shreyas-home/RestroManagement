<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestroManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestroManagement.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .sidebar a:hover {
            background-color: #F8B259;
            box-shadow: 0 0 10px black;
        }

        .activePage {
            background-color: #D96F32 !important;
            color: #F3E9DC !important;
        }
    </style>
</head>
@{
    var bodyClass = (ViewData["BodyClass"] as string) ?? "theme-modern";
}


