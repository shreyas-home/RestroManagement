                            <i class="bi bi-menu-down h2"></i>
                            <p>Products</p>
                        </a>
                    </li>

                    <li class="nav-item m-1 p-0 border-0 shadow-sm">
                        <a class="nav-link text-dark border rounded p-3 fw-semibold shadow-sm 
                        @(ViewBag.ActivePage == "Inventory" ? "activePage" : "")" asp-area="" asp-controller="Inventory" asp-action="Index">
